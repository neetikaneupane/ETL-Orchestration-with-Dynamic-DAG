# ===========================================
# Self-Healing ETL - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.

# ---- Airflow ----
# UID for the Airflow containers (Linux only; ignored on macOS)
AIRFLOW_UID=50000
# Fernet key for Airflow secret backend (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=generate_a_real_key
# Airflow admin credentials (created on first init)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME

# ---- PostgreSQL ----
POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=airflow

# ---- Redis (message broker) ----
REDIS_PASSWORD=CHANGE_ME

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
